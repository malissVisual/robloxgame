		<Item class="StringValue" referent="RBXAC9A95BD54D9F75E0EDCFE77B82A3EC8">
			<Properties>
				<string name="Name">Appearance</string>
				<string name="Value">Šaman ve vlčí kápi s lebkou a svítícíma očima, tlapy kožešiny visí přes hruď, dlouhý roztřepený medvědí plášť a kožešinové válce na ramenou. Totemová hůl s malovanou tváří, zobákem a křídly drží krystal v dřevěných drápech; v levé ruce zdobená nádoba, ze které stoupá fialový dým.</string>
			</Properties>
		</Item>
	</Item>
</roblox>
