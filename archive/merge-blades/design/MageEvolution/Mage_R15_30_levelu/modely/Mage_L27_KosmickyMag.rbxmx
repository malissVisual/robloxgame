			<Properties>
				<string name="Name">Appearance</string>
				<string name="Value">Kosmický mág v bílých panelech s levitujícími nárameníky, energetickou aureolou za hlavou a pláštěm s hvězdným polem. Hůl s gyroskopem ze dvou prstenců, v levé ruce kosmická koule s prstencem.</string>
