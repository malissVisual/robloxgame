		<Item class="StringValue" referent="RBXE49426B9E2EB5B62D869BCB188EDD176">
			<Properties>
				<string name="Name">Appearance</string>
				<string name="Value">Čaroděj ve fialovém hábitu se zvonovými rukávy, indigovém plášti a měkkém špičatém klobouku se zalomenou špičkou. Pokroucená hůl drží krystal ve třech drápech a kolem hlavice levitují dvě runy; v levé ruce otevřená kniha kouzel se svítícími runami.</string>
			</Properties>
