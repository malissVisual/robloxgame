		<Item class="StringValue" referent="RBXAE889AD5E2AA98EF7D8A7B32EA332231">
			<Properties>
				<string name="Name">Appearance</string>
				<string name="Value">Velmistr v obřím klobouku se zatočenou špičkou, perem a drahokamem, s vrstvenými hábity, zlatou výšivkou, nárameníky a dlouhým vousem po pás. Zlatá hůl s drahokamy na násadě, čtyřmi drápy a šesti levitujícími krystaly; v levé ruce grimoár se zámkem na řetězu.</string>
			</Properties>
		</Item>
