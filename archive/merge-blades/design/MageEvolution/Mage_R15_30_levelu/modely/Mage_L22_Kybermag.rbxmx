			<Properties>
				<string name="Name">Appearance</string>
				<string name="Value">Kybermág s neonovým vizorem a vyholenými boky, v pancéřové vestě s LED pásky a chrániči kolen. Kolem hole se vznáší holografické panely, hlavice má emitorový prstenec; v levé ruce datový krystal v pouzdře.</string>
