		<Item class="StringValue" referent="RBXBB400AC1A55F0AA08EFE29643AC2BEEB">
			<Properties>
				<string name="Name">Appearance</string>
				<string name="Value">Parní mág ve fialovém fraku se šosy, vestě s knoflíky a nákrčníku, s cylindrem ozdobeným ozubenými koly a brýlemi. Přes hruď bandalír s lahvičkami. Hůl s tlakovou nádobou, ventilovým kolem, manometrem a obláčky páry; v levé ruce mosazná koule s průzory.</string>
			</Properties>
		</Item>
	</Item>
</roblox>
