s="Part" referent="RBX207"><Properties><string name="Name">Part</string><bool name="Anchored">true</bool><Vector3 name="size"><X>0.18</X><Y>3.2</Y><Z>0.18</Z></Vector3><CoordinateFrame name="CFrame"><X>17.949390334559013</X><Y>2.32</Y><Z>-2.0506096654409878</Z><R00>1.0</R00><R01>0.0</R01><R02>0.0</R02><R10>0.0</R10><R11>1.0</R11><R12>0.0</R12><R20>0.0</R20><R21>0.0</R21><R22>1.0</R22></CoordinateFrame><Color3uint8 name="Color3uint8">4294688548</Color3uint8><token name="Material">288</token><token name="TopSurface">0</token><token name="BottomSurface">0</token><float name="Transparency">0.4</float><bool name="CanQuery">false</bool><bool name="CanCollide">false</bool><bool name="CastShadow">false</bool><bool name="CanTouch">false</bool></Properties></Item><Item class="Part" referent="RBX208"><Properties><string name="Name">Part</string><bool name="Anchored">true</bool><Vector3 name="size"><X>0.18</X><Y>3.2</Y><Z>0.18</Z></Vector3><CoordinateFrame name="CFrame"><X>20.0</X><Y>2.32</Y><Z>-2.9</Z><R00>1.0</R00><R01>0.0</R01><R02>0.0</R02><R10>0.0</R10><R11>1.0</R11><R12>0.0</R12><R20>0.0</R20><R21>0.0</R21><R22>1.0</R22></CoordinateFrame><Color3uint8 name="Color3uint8">4294688548</Color3uint8><token name="Material">288</token><token name="TopSurface">0</token><token name="BottomSurface">0</token><float name="Transparency">0.4</float><bool name="CanQuery">false</bool><bool name="CanCollide">false</bool><bool name="CastShadow">false</bool><bool name="CanTouch">false</bool></Properties></Item><Item class="Part" referent="RBX209"><Properties><string name="Name">Part</string><bool name="Anchored">true</bool><Vector3 name="size"><X>0.18</X><Y>3.2</Y><Z>0.18</Z></Vector3><CoordinateFrame name="CFrame"><X>22.050609665440987</X><Y>2.32</Y><Z>-2.050609665440988</Z><R00>1.0</R00><R01>0.0</R01><R02>0.0</R02><R10>0.0</R10><R11>1.0</R11><R12>0.0</R12><R20>0.0</R20><R21>0.0</R21><R22>1.0</R22></CoordinateFrame><Color3uint8 name="Color3uint8">4294688548</Color3uint8><token name="Material">288</token><token name="TopSurface">0</token><token name="BottomSurface">0</token><float name="Transparency">0.4</float><bool name="CanQuery">false</bool><bool name="CanCollide">false</bool><bool name="CastShadow">false</bool><bool name="CanTouch">false</bool></Properties></Item></Item></Item><Item class="Script" referent="RBX210"><Properties><string name="Name">AuraAnimation</string><ProtectedString name="Source"><![CDATA[-- Spins the rune rings and orbs and pulses the glow of every aura in this model
local RunService = game:GetService("RunService")
local root = script.Parent
local SPEED = { Runes = 0.9, RunesB = -0.6, Orbs = 1.8 }

local auras = {}
for _, d in ipairs(root:GetDescendants()) do
	if d:IsA("Model") and d:FindFirstChild("Center") and d:FindFirstChild("GlowDisk") then
		auras[d] = d.GlowDisk.Transparency
	end
end

local t = 0
RunService.Heartbeat:Connect(function(dt)
	t += dt
	for aura, base in pairs(auras) do
		if aura.Parent then
			local c = aura.Center.CFrame
			for name, speed in pairs(SPEED) do
				local spin = aura:FindFirstChild(name)
				if spin then
					spin:PivotTo(c * CFrame.Angles(0, speed * dt, 0) * c:ToObjectSpace(spin:GetPivot()))
				end
			end
			aura.GlowDisk.Transparency = base + math.sin(t * 3) * 0.05
		end
	end
end)
]]></ProtectedString></Properties></Item></Item></roblox>