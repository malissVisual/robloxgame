		<Item class="StringValue" referent="RBX20147B622F1488BC8842C56A789BC7A8">
			<Properties>
				<string name="Name">Appearance</string>
				<string name="Value">Mistr éteru se svítícíma očima a mechanickou korunou na klobouku, dlouhým kabátem, mosaznou výztuhou pravé paže a batohem s nádržemi. Hůl s otočnými mosaznými prstenci, ciferníky a šesti levitujícími krystaly; v levé ruce kámen mudrců v mosazné kleci.</string>
			</Properties>
