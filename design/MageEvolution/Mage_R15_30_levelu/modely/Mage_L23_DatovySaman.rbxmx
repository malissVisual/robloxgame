			<Properties>
				<string name="Name">Appearance</string>
				<string name="Value">Datový šaman v kápi s neonovým lemem a svítícím obvodovým tetováním na tváři. Nad ramenem se vznáší dron. Hůl má šestiúhelníkový rám kolem krystalu a obíhající datové kostky; v levé ruce holografická kniha.</string>
