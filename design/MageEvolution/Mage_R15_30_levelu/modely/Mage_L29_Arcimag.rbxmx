			<Properties>
				<string name="Name">Appearance</string>
				<string name="Value">Kosmický arcimág se svítící energetickou korunou s hroty, velkou aureolou a křídly z krystalových panelů. Hůl nese shluk krystalů v gyroskopu, kolem těla levitují krystaly; v levé ruce singularita uzavřená v prstencích.</string>
			</Properties>
