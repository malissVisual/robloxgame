		<Item class="StringValue" referent="RBX4A3C8C1217B1021A9D7CD7A934420598">
			<Properties>
				<string name="Name">Appearance</string>
				<string name="Value">Alchymista v indigovém kabátě s koženou zástěrou, kotletami a koženou čepicí s mosaznými brýlemi. Opasek s lahvičkami barevných elixírů. Mosazná hůl drží krystal v kleci, má měřidlo a měděnou trubici; v levé ruce baňka s bublajícím elixírem.</string>
			</Properties>
