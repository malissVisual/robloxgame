		<Item class="StringValue" referent="RBX2FFED140442F1094F32D24DB736E02A0">
			<Properties>
				<string name="Name">Appearance</string>
				<string name="Value">Velitel technomágů s vysokým límcem, anténami a korunovým vizorem, v pancéřovém kabátě s plným energetickým jádrem. Kolem těla se vznáší holografické runy; hůl s velkým emitorovým prstencem a krystaly, v levé ruce plazmové jádro.</string>
			</Properties>
