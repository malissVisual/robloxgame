		<Item class="StringValue" referent="RBXC90285EF0F5FF190310B2F299EE11817">
			<Properties>
				<string name="Name">Appearance</string>
				<string name="Value">Vrchol evoluce: Apex mág s korunou z energie, trojitou aureolou a křídly ze světla, v bílozlatých panelech s fialovými a azurovými spoji a pláštěm z hvězd. Hůl je kvantové ohnisko se třemi gyroskopy a velkým krystalem, kolem obíhá roj krystalů; v levé ruce kvantová krychle.</string>
			</Properties>
		</Item>
