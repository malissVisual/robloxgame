		<Item class="StringValue" referent="RBX3AA598DF76898A39529B168563525126">
			<Properties>
				<string name="Name">Appearance</string>
				<string name="Value">Kouzelník s krátkým prošedivělým vousem, širokým hvězdným kloboukem se zlatou přezkou a pláštěm posetým hvězdami. Hůl se čtyřmi zlatými drápy a hvězdou na špici, kolem ní levitují tři krystaly; v levé ruce svítící koule.</string>
			</Properties>
