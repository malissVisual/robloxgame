		<Item class="StringValue" referent="RBXDB3C30D1FB56F715370862AFB5BED208">
			<Properties>
				<string name="Name">Appearance</string>
				<string name="Value">Elektromág s brýlemi na očích a cylindrem, z něhož vyrůstá Teslova cívka. Na zádech batoh se dvěma měděnými nádržemi a trubkami. Hůl nese stoh měděných prstenců a krystal obklopený výboji; v levé ruce skleněný globus s bleskem.</string>
			</Properties>
