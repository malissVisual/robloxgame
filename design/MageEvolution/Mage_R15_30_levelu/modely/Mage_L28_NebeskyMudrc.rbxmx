			<Properties>
				<string name="Name">Appearance</string>
				<string name="Value">Nebeský mudrc s vysokou panelovou korunou, dvojitou aureolou a zářícím vousem, kolem pasu obíhá prstenec krystalů. Hůl s trojitým gyroskopem a hvězdným krystalem; v levé ruce levitující holografický svitek.</string>
			</Properties>
